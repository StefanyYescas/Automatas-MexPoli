PARSER_BEGIN(Polinomios)

public class Polinomios {

    public static void main(String[] args) {

        try {

            Polinomios parser = new Polinomios(System.in);
            parser.programa();

            System.out.println("\nPrograma sintacticamente correcto");

        }

        // ERROR SINTACTICO 
        catch (ParseException e) {

            Token t = e.currentToken.next;

            System.out.println("        ERROR SINTACTICO");

            System.out.println("\nSe encontro un problema en la estructura del programa.\n");

            System.out.println("→ Linea     : " + t.beginLine);
            System.out.println("→ Columna   : " + t.beginColumn);
            System.out.println("→ Simbolo   : " + t.image);

            System.out.println("\nDescripcion:");

            if (t.image.equals("}")) {

                System.out.println("Falta ';' antes de cerrar el bloque.");

            }

            else if (t.image.equals(")")) {

                System.out.println("Falta una expresion o hay parentesis desbalanceados.");

            }

            else if (t.image.equals("else")) {

                System.out.println("El bloque else esta mal ubicado.");

            }

            else if (t.image.equals(";")) {

                System.out.println("Hay una instruccion incompleta.");

            }

            else {

                System.out.println("La estructura ingresada no coincide con la gramatica.");

            }

            System.out.println("\nSugerencia:");
            System.out.println("Revisa la instruccion cercana al simbolo indicado.\n");
        }

        //  ERROR LEXICO 
        catch (TokenMgrError e) {

            String mensaje = e.getMessage();

            int linea = 0;
            int columna = 0;
            String simbolo = "?";

            try {

                // ===== LINEA =====
                int inicioLinea = mensaje.indexOf("line ");
                int finLinea = mensaje.indexOf(",", inicioLinea);

                String textoLinea =
                    mensaje.substring(inicioLinea + 5, finLinea);

                linea = Integer.parseInt(textoLinea.trim());


                //  COLUMNA 
                int inicioColumna = mensaje.indexOf("column ");
                int finColumna = mensaje.indexOf(".", inicioColumna);

                String textoColumna =
                    mensaje.substring(inicioColumna + 7, finColumna);

                columna = Integer.parseInt(textoColumna.trim());


                //  CARACTER 
                int primeraComilla = mensaje.indexOf("'");

                int segundaComilla =
                    mensaje.indexOf("'", primeraComilla + 1);

                simbolo =
                    mensaje.substring(
                        primeraComilla + 1,
                        segundaComilla
                    );

            }

            catch(Exception ex) {

                System.out.println("\nNo se pudo interpretar el error lexico.\n");
            }


            System.out.println("          ERROR LEXICO");

            System.out.println("\nSe detecto un simbolo invalido.\n");

            System.out.println("→ Linea     : " + linea);
            System.out.println("→ Columna   : " + columna);
            System.out.println("→ Caracter  : " + simbolo);

            System.out.println("\nDescripcion:");
            System.out.println("El simbolo no pertenece al lenguaje.");

            System.out.println("\nSugerencia:");
            System.out.println("Utiliza un simbolo valido dentro de la gramatica.\n");
        }
    }
}

PARSER_END(Polinomios)


//  ESPACIOS

SKIP :
{
    " "
  | "\t"
  | "\n"
  | "\r"
}


//  TOKENS 

TOKEN :
{
    < PROGRAMA: "programa" >
  | < INICIO: "inicio" >
  | < IF: "if" >
  | < ELIF: "elif" >
  | < ELSE: "else" >
  | < WHILE: "while" >

  | < REDUCIR: "reducir" >
  | < EVALUAR: "evaluar" >
  | < EXPANDIR: "expandir" >
  | < FACTORIZAR: "factorizar" >
  | < ORDENAR: "ordenar" >

  | < LEER: ">>" >
  | < IMPRIMIR: "<<" >

  | < TRUE: "true" >
  | < FALSE: "false" >

  | < TIPO: "polinomio" | "8b" | "16s" | "16d" | "16c" | "1b" >

  | < ID: ["a"-"z"] (["a"-"z","0"-"9"])* >

  | < NUM: (["0"-"9"])+ >

  | < MAS: "+" >
  | < MENOS: "-" >
  | < MUL: "*" >
  | < DIV: "/" >
  | < POT: "^" >

  | < AND: "&&" >
  | < OR: "||" >
  | < NOT: "!" >

  | < MAYORIG: ">=" >
  | < MENORIG: "<=" >
  | < IGUAL: "==" >
  | < DIF: "!=" >
  | < MAYOR: ">" >
  | < MENOR: "<" >

  | < ASIG: "=" >

  | < PYC: ";" >

  | < PAR_A: "(" >
  | < PAR_C: ")" >

  | < LLAVE_A: "{" >
  | < LLAVE_C: "}" >
}


// PARSER


//  PROGRAMA

void programa() :
{}
{
    <PROGRAMA>
    <LLAVE_A>
    inicio()
    instrucciones()
    <LLAVE_C>
    <EOF>
}


//  INICIO 

void inicio() :
{}
{
    <INICIO> <LLAVE_A> declaraciones()
    <LLAVE_C>
}


//  BLOQUE 

void bloque() :
{}
{
    <LLAVE_A>
    instrucciones()
    <LLAVE_C>
}


//  DECLARACIONES 

void declaraciones() :
{}
{
    (
        <TIPO>
        <ID>
        (
            <ASIG> expresion()
        )?
        <PYC>
    )*
}


// INSTRUCCIONES 

void instrucciones() :
{}
{
    (
        instruccion()
    )*
}


//  INSTRUCCION 

void instruccion() :
{}
{
      asignacion()
    | funcion()
    | condicional()
    | ciclo()
}


// ===== ASIGNACION =====

void asignacion() :
{}
{
    <ID>
    <ASIG>
    expresion()
    <PYC>
}




// EXPRESIONES 

void expresion() :
{}
{
    exp_or()
}


// OR 

void exp_or() :
{}
{
    exp_and()
    (
        <OR>
        exp_and()
    )*
}


//  AND 

void exp_and() :
{}
{
    exp_rel()
    (
        <AND>
        exp_rel()
    )*
}


//  RELACIONALES 

void exp_rel() :
{}
{
    exp_arit()
    (
        (
              <MAYOR>
            | <MENOR>
            | <MAYORIG>
            | <MENORIG>
            | <IGUAL>
            | <DIF>
        )
        exp_arit()
    )?
}


//  ARITMETICAS 

void exp_arit() :
{}
{
    termino()
    (
        (
              <MAS>
            | <MENOS>
        )
        termino()
    )*
}


//  TERMINOS 

void termino() :
{}
{
    factorMultiplicativo()
    (
        (
              <MUL>
            | <DIV>
        )
        factorMultiplicativo()
    )*
}


//  MULTIPLICACION IMPLICITA

void factorMultiplicativo() :
{}
{
    potencia()
    (
        LOOKAHEAD(2)
        potencia()
    )*
}


//  POTENCIAS 

void potencia() :
{}
{
    unario()
    (
        <POT>
        unario()
    )*
}


//  UNARIO 

void unario() :
{}
{
      <MENOS> unario()
    | primario()
}


//  PRIMARIO 

void primario() :
{}
{
      <PAR_A> expresion() <PAR_C>
    | polinomio()
    | <TRUE>
    | <FALSE>
}


//  POLINOMIOS 

void polinomio() :
{}
{
      LOOKAHEAD(3)
      <NUM> <ID> <POT> <NUM>

    | LOOKAHEAD(2)
      <NUM> <ID>

    | LOOKAHEAD(3)
      <ID> <POT> <NUM>

    | <ID>

    | <NUM>
}


//  FUNCIONES 


void funcion() :
{}
{
      <LEER>
      <ID>
      <PYC>

    | <IMPRIMIR>
      expresion()
      <PYC>

    | <REDUCIR>
      <PAR_A>
      expresion()
      <PAR_C>
      <PYC>

    | <EVALUAR>
      <PAR_A>
      expresion()
      <PAR_C>
      <PYC>

    | <EXPANDIR>
      <PAR_A>
      expresion()
      <PAR_C>
      <PYC>

    | <FACTORIZAR>
      <PAR_A>
      expresion()
      <PAR_C>
      <PYC>

    | <ORDENAR>
      <PAR_A>
      expresion()
      <PAR_C>
      <PYC>
}


//  CONTROL 

void condicional() :
{}
{
    <IF>
    <PAR_A>
    expresion()
    <PAR_C>
    bloque()

    (
        <ELIF>
        <PAR_A>
        expresion()
        <PAR_C>
        bloque()
    )*

    (
        <ELSE>
        bloque()
    )?
}


//  WHILE 

void ciclo() :
{}
{
    <WHILE>
    <PAR_A>
    expresion()
    <PAR_C>
    bloque()
}
